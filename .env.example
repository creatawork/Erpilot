# 复制为 .env 并填入（.env 已被 gitignore，不要提交真实密钥）

# 模型供应商预设（agent_core LLMConfig.from_env）：zhipu（默认）/ deepseek / qwen
# 切换只需改 LLM_PROVIDER，并填入对应供应商的 API key；base_url/model 仍可用下方 env 覆盖。
LLM_PROVIDER=zhipu

# 智谱开放平台：https://open.bigmodel.cn （模型 ID 以控制台为准）
ZHIPU_API_KEY=
# DeepSeek：https://platform.deepseek.com （LLM_PROVIDER=deepseek 时读取）
DEEPSEEK_API_KEY=
# 阿里云百炼 DashScope（Qwen，OpenAI 兼容模式）：LLM_PROVIDER=qwen 时读取
DASHSCOPE_API_KEY=

# 可选：覆盖所选供应商预设的端点 / 模型（第三方中转端点记得带 /v1/ 后缀）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-5.3-flash

# API tool source: mcp uses the local SQLite ERP database; omit to use demo tools.
ERPILOT_TOOLS=mcp
ERPILOT_WRITES=0

# Forward provider reasoning_content when available; no synthetic thinking text.
ERPILOT_THINKING=1

# Langfuse 自托管（M3 接入可观测时再填）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Required for API graph state; ERP business data / RunStore stay in SQLite.
# Local Docker demo only; never use these credentials in production.
ERPILOT_CHECKPOINT_DATABASE_URL=postgresql://erpilot:erpilot_local@localhost:5433/erpilot
